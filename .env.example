# ==============================================================================
# Alpaca Cryptocurrency Paper Trading Bot Configuration
# ==============================================================================

# --- Alpaca Paper Trading Credentials ---
# Acquire your free paper trading API keys at: https://app.alpaca.markets
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_PAPER=True
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Trading Target & Execution ---
TARGET_SYMBOL=BTC/USD
CYCLE_INTERVAL_SECONDS=60
ORDER_SIZE_USD=500.0
MAX_POSITION_USD=5000.0

# --- Tri-Factor Weights (Must sum to 1.0) ---
WEIGHT_TECHNICAL=0.40
WEIGHT_VOLUME=0.30
WEIGHT_SENTIMENT=0.30

# --- Signal Thresholds & Risk Management ---
BUY_TRIGGER_SCORE=0.60
SELL_TRIGGER_SCORE=-0.40
TRAILING_STOP_LOSS_PCT=0.05

# --- Virtual Tax Escrow Engine ---
TAX_RATE=0.30
TAX_RESERVE_FILE=tax_reserve.json

# --- Sentiment Factor Configuration ---
# Options: ollama (default), gemini, finbert, mock
SENTIMENT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Alternative Ollama model: llama3.1:8b

# Optional API Keys for alternative sentiment providers
GEMINI_API_KEY=

# --- Trade Alerts (iMessage & ntfy.sh iOS PWA Push) ---
ALERT_ENABLED=True
ALERT_RECIPIENT=eckermike87@icloud.com
NTFY_TOPIC=eckermike87
ALERT_MACOS_BANNER=True

# --- Option Wheel Strategy (Multi-Asset Portfolio) ---
WHEEL_ENABLED=True
WHEEL_SYMBOL=INTC
WHEEL_SYMBOLS=INTC,F,SOFI,HOOD,PLTR,XLF
WHEEL_TARGET_DTE_MIN=21
WHEEL_TARGET_DTE_MAX=45
WHEEL_TARGET_DELTA=0.25
WHEEL_PROFIT_TARGET_PCT=0.50
WHEEL_CONTRACTS=1
